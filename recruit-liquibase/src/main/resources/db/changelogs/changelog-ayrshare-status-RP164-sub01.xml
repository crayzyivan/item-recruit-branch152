    <changeSet id="r-job-ayrshare-status-add-20250130" author="lh">
        <preConditions>
            <not>
                <columnExists tableName="r_job" columnName="ayrshare_status"/>
            </not>
        </preConditions>
        <sql>
            ALTER TABLE `r_job` ADD COLUMN `ayrshare_status` int NOT NULL DEFAULT 0 COMMENT 'Ayrshare分享状态：0-不需要分享，1-分享中，2-分享成功，3-部分成功，-1-分享失败';
        </sql>
    </changeSet>

